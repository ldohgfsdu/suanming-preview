.page { padding: 40rpx 32rpx 60rpx; max-width: 720rpx; margin: 0 auto; }

.hero { padding: 24rpx 8rpx 40rpx; }
.hero-title { font-size: 44rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { margin-top: 12rpx; color: var(--muted); font-size: 24rpx; }

.card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.03);
}

.row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.label { color: var(--muted); font-size: 26rpx; }
.picker { flex: 1; text-align: right; }
.picker-value { font-size: 30rpx; color: var(--ink); }
.lon-input {
  flex: 1; text-align: right; font-size: 30rpx;
  border-bottom: 1rpx solid var(--line); padding: 4rpx 0;
}
.ph { color: #bdbdbd; font-size: 26rpx; }

.btn {
  margin-top: 32rpx;
  background: var(--ink);
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  letter-spacing: 4rpx;
}
.btn::after { border: none; }

/* result */
.result-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24rpx; }
.result-title { font-size: 34rpx; font-weight: 600; }
.result-meta { color: var(--muted); font-size: 26rpx; }

.pillars { display: flex; justify-content: space-around; padding: 10rpx 0 24rpx; }
.pillar { text-align: center; flex: 1; }
.pillar-label { color: var(--muted); font-size: 22rpx; margin-bottom: 10rpx; letter-spacing: 2rpx; }
.pillar-ganzhi { font-size: 44rpx; font-weight: 600; line-height: 1.25; }
.pillar-elem { margin-top: 10rpx; font-size: 22rpx; color: var(--accent); }

.section-title { font-size: 26rpx; color: var(--muted); margin: 8rpx 0 16rpx; letter-spacing: 2rpx; }

.tally { display: flex; flex-wrap: wrap; }
.tally-chip {
  display: flex; align-items: center;
  margin: 6rpx 14rpx 6rpx 0;
  padding: 10rpx 22rpx;
  background: #f5f5f0;
  border-radius: 30rpx;
}
.tally-name { font-size: 26rpx; }
.tally-n { font-size: 30rpx; font-weight: 600; margin-left: 12rpx; color: var(--accent); }

.kv {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.k { color: var(--muted); font-size: 25rpx; }
.v { font-size: 28rpx; text-align: right; }
.divider { height: 1rpx; background: var(--line); margin: 24rpx 0; }

.note { margin-top: 28rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }