<view class="page">

  <!-- 档案头：以日期为主标题，方法来源为副标题（不重复导航栏标题） -->
  <view class="result-title">{{r.solarCN}} <text class="result-tag">生辰历法档案</text></view>
  <view class="result-sub">由真实天文历法计算</view>

  <view class="pillars" wx:if="{{r.pillars && r.pillars.length}}">
    <view class="pillar {{item.unknown ? 'is-unknown' : ''}}" wx:for="{{r.pillars}}" wx:key="label">
      <view class="pillar-ganzhi">{{item.ganz}}</view>
      <view class="pillar-meta"><text class="pillar-label">{{item.label}}</text><text class="pillar-elem">{{item.element || '时辰未知'}}</text></view>
    </view>
  </view>
  <view class="hour-unknown-hint" wx:if="{{r.hourUnknown}}">出生时刻未选择，时柱以「时辰未知」占位。</view>

  <view class="kv" wx:if="{{r.lunarText}}"><text class="k">农历</text><text class="v">{{r.lunarText}}<text wx:if="{{r.lunarApprox}}" class="approx">（朔日前后±1天）</text></text></view>
  <view class="kv kv-place">
    <text class="k">出生地点</text>
    <view class="v place-block">
      <view class="place-name">{{r.placeName}}</view>
      <view class="place-coord" wx:if="{{r.placeCoord}}">{{r.placeCoord}}</view>
    </view>
  </view>

  <!-- 出生时间 / 真太阳时（单一时间源：仅展示，不重复计算） -->
  <view class="kv" wx:if="{{r.bjTime}}"><text class="k">出生时间（北京时间）</text><text class="v">{{r.bjTime}}</text></view>
  <view class="kv" wx:if="{{r.tsDateTime}}">
    <text class="k">真太阳时<text wx:if="{{r.crossDay}}" class="kv-tag">跨日</text></text>
    <text class="v">{{r.tsDateTime}}</text>
  </view>
  <view class="kv" wx:if="{{r.trueSolar && r.trueSolar !== '未提供地点'}}"><text class="k">修正量</text><text class="v">{{r.trueSolar}}</text></view>
  <view class="cross-day-banner" wx:if="{{r.crossDay && r.canonDateText}}">真太阳时校正后已进入次日（{{r.canonDateText}}），相关历法数据均按校正后的时间重新计算。</view>

  <view class="divider"></view>

  <view class="section-title">五行四柱字数</view>
  <view class="tally" wx:if="{{r.tally && r.tally.length}}">
    <view class="tally-row {{item.empty ? 'is-empty' : ''}}" wx:for="{{r.tally}}" wx:key="name">
      <view class="tally-name">{{item.name}}</view>
      <view class="tally-track">
        <view class="tally-fill" style="width:{{item.pct}}%"></view>
      </view>
      <view class="tally-n">{{item.n}}</view>
    </view>
  </view>
  <view class="tally" wx:else><view class="tally-empty">—</view></view>

  <view class="divider"></view>

  <view class="section-title">节气</view>
  <view class="kv"><text class="k">上一个节气</text><text class="v">{{r.prevTerm}}</text></view>
  <view class="kv"><text class="k">下一个节气</text><text class="v">{{r.nextTerm}}</text></view>
  <view class="kv"><text class="k">距下节气</text><text class="v">{{r.daysToNext}}</text></view>

  <view class="divider"></view>

  <view class="section-title">月相<text class="section-inline" wx:if="{{r.moonPhase}}">　{{r.moonPhase}}</text></view>
  <view class="kv"><text class="k">朔望月龄</text><text class="v">{{r.moonAge || '—'}}</text></view>
  <view class="mb-bar" wx:if="{{r.moonLit}}">
    <view class="mb-track"><view class="mb-fill" style="width:{{r.moonLit.litPct}}%"></view></view>
    <text class="mb-pct">{{r.moonLit.filling}} · 照亮约 {{r.moonLit.litPct}}%</text>
  </view>

  <view class="divider"></view>

  <!-- AI 文化解读：AI 只解释已算好的事实，不做任何判定 -->
  <view class="section-title">
    历法文化解读
    <text class="section-inline">{{insightModel}}</text>
  </view>
  <!-- 未生成：须用户点击才生成（铁律：AI 显式触发） -->
  <view class="insight-idle" wx:if="{{insightState === 'idle'}}">
    <button class="btn-insight" bindtap="onGenerateInsight">生成历法文化解读</button>
    <view class="insight-hint">解读仅说明上方已算好的历法事实的文化背景</view>
  </view>

  <view class="insight-loading" wx:elif="{{insightState === 'loading'}}">
    <text class="loading-dot">正在生成文化解读…</text>
    <text class="loading-sub">解读基于上方已算好的历法事实，仅作文化背景补充</text>
  </view>
  <view class="insight-body" wx:elif="{{insightSections && insightSections.length}}">
    <view class="insight-item" wx:for="{{insightSections}}" wx:key="id">
      <view class="insight-item-title">
        <text>{{item.title}}</text>
        <text class="insight-badge {{item.contentType === 'FACT' ? 'is-fact' : 'is-culture'}}">{{item.contentType === 'FACT' ? '事实' : '文化背景'}}</text>
      </view>
      <view class="insight-item-content">{{item.content}}</view>
    </view>
    <view class="insight-limitation" wx:if="{{insightLimitations && insightLimitations.length}}">
      <text class="insight-limitation-title">说明</text>
      <text wx:for="{{insightLimitations}}" wx:key="*this" class="insight-limitation-item">· {{item}}</text>
    </view>
  </view>
  <view class="insight-body" wx:else>
    <view class="insight-item">
      <view class="insight-item-content">解读生成暂不可用。上方历法档案由本地确定性引擎计算，不受此影响，可正常查看与使用。</view>
    </view>
    <button class="btn-insight insight-retry" bindtap="onGenerateInsight">重新生成解读</button>
  </view>

  <view class="note">本档案由真实天文历法计算得出：结果均源自真太阳时、天文节气等历法数据，仅供传统文化研究与娱乐参考。</view>

  <button class="btn-save" bindtap="onSaveCard">保存档案卡片</button>

  <view class="back-hint" bindtap="goBackHome">← 返回首页修改参数</view>

  <!-- 分享卡片画布（离屏） -->
  <canvas class="share-canvas" canvas-id="shareCard" style="width:600px;height:760px;"></canvas>
</view>