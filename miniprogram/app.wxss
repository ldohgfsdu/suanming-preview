page {
  --paper: #f7f5f1;
  --card: #ffffff;
  --tint: #f2efe9;
  --ink: #2c2a26;
  --body: #4a463f;
  --muted: #8b867c;
  --line: #e4e0d6;
  --accent: #9a6b4f;
  --btn: #2c2a26;
  --btn-text: #ffffff;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

/* 深色模式：仅覆盖变量，全站配色跟随系统 */
@media (prefers-color-scheme: dark) {
  page {
    --paper: #1a1815;
    --card: #24211d;
    --tint: #2c2924;
    --ink: #ece8e0;
    --body: #c8c2b8;
    --muted: #8f8a80;
    --line: #38342d;
    --accent: #c08a63;
    --btn: #2c2a26;
    --btn-text: #ffffff;
  }
}

/* ── 就地科普：ⓘ 锚点与就地展开面板（archive 页与今日天时页共用） ── */
/* ⓘ 放在标签/标题末尾。padding 撑到 44rpx 见方，保证在密集表格里也点得中。 */
.info {
  margin-left: 10rpx;
  padding: 6rpx 8rpx;
  color: var(--accent);
  font-size: 26rpx;
  line-height: 1.2;
}

/* 展开面板：紧贴被点开的概念所在位置，就地解释，不把人带离当前页 */
.culture-inline {
  margin: 12rpx 0 4rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: var(--tint);
  border-left: 4rpx solid var(--accent);
}
.culture-inline-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.culture-inline-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}
.culture-inline-more {
  font-size: 22rpx;
  color: var(--accent);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.culture-inline-body {
  font-size: 24rpx;
  color: var(--body);
  line-height: 1.75;
}