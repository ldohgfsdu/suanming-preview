.page { padding: 48rpx 32rpx 80rpx; max-width: 720rpx; margin: 0 auto; display: flex; flex-direction: column; }

.hero {
  padding: 6rpx 8rpx 36rpx;
  text-align: center;
}
.hero-title { font-size: 44rpx; font-weight: 600; letter-spacing: 4rpx; }
.hero-sub { margin-top: 12rpx; color: var(--muted); font-size: 23rpx; letter-spacing: 1rpx; }

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 10rpx 32rpx rgba(0, 0, 0, 0.04);
}

/* ---------- 今日天时 ---------- */
.today-card { position: relative; }
.today-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.today-title { font-size: 28rpx; font-weight: 600; letter-spacing: 3rpx; color: var(--ink); }
.today-info { color: var(--muted); font-size: 30rpx; padding: 4rpx 10rpx; }
.today-tools { display: flex; align-items: center; gap: 8rpx; }
.today-more { font-size: 24rpx; color: var(--accent); padding: 4rpx 8rpx; }
.today-foot { margin-top: 20rpx; text-align: center; font-size: 24rpx; color: var(--accent); padding-top: 4rpx; }
/* 分享画布：离屏不可见，但保持渲染能力 */
.share-canvas { position: fixed; left: -9999px; top: 0; pointer-events: none; }

/* 保存卡片按钮 */
.btn-save {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--card);
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 16rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.btn-save::after { border: none; }
.today-ganzhi {
  font-size: 44rpx; font-weight: 600; line-height: 1.4;
  letter-spacing: 3rpx; margin-bottom: 28rpx; color: var(--accent);
}
.today-grid { display: flex; flex-wrap: wrap; }
.t-cell { width: 25%; box-sizing: border-box; padding: 8rpx 4rpx; }
.t-k { color: var(--muted); font-size: 22rpx; margin-bottom: 10rpx; }
.t-v { font-size: 30rpx; font-weight: 500; }
.t-s { margin-top: 6rpx; font-size: 20rpx; color: var(--accent); }
.today-moon { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); font-size: 25rpx; color: var(--muted); }
.today-moon text { color: var(--ink); }

/* ---------- 表单 ---------- */
.section-head { font-size: 24rpx; color: var(--muted); letter-spacing: 3rpx; margin-bottom: 28rpx; }

.mode-tabs { display: flex; margin-bottom: 28rpx; background: var(--tint); border-radius: 14rpx; padding: 6rpx; }
.mode-tab {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 11rpx;
  font-size: 28rpx; color: var(--muted); transition: all 0.2s;
}
.mode-tab.on { background: var(--card); color: var(--ink); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }

.row {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 20rpx 0 22rpx; border-bottom: 1rpx solid var(--line);
}
.label { color: var(--muted); font-size: 27rpx; padding-top: 6rpx; display: flex; align-items: center; }
.why { margin-left: 8rpx; color: var(--accent); font-size: 26rpx; }
.row-noborder { border-bottom: none; }
.gender-switch {
  display: flex; gap: 20rpx;
}
.gender-opt {
  padding: 10rpx 40rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 27rpx;
  background: var(--card);
  transition: all 0.15s;
}
.gender-opt.on {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.picker { flex: 1; text-align: right; }
.picker-value { font-size: 30rpx; color: var(--ink); }

.place-pickers { flex: 1; text-align: right; display: flex; flex-direction: column; align-items: flex-end; }
.place-pickers .picker { width: 100%; display: block; }
.place-hint { margin-top: 12rpx; color: var(--accent); font-size: 23rpx; }

/* ---------- 出生地点（三线下拉） ---------- */
.sub-head { display: flex; align-items: center; margin-top: 8rpx; color: var(--ink); font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }
.sub-head .why { margin-left: 10rpx; color: var(--accent); font-size: 28rpx; }
.place-line {
  margin-top: 18rpx;
  display: flex; align-items: center;
  background: var(--tint); border: 1rpx solid var(--line); border-radius: 16rpx;
  padding: 26rpx 26rpx;
}
.place-label { font-size: 22rpx; color: var(--muted); margin-right: 20rpx; flex-shrink: 0; }
.place-value { flex: 1; font-size: 30rpx; color: var(--ink); font-weight: 500; }
.place-arrow { color: var(--muted); font-size: 22rpx; margin-left: 12rpx; }
.place-links { display: flex; gap: 20rpx; margin-top: 20rpx; }
.place-link {
  flex: 1;
  display: flex; align-items: center; justify-content: space-between;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 14rpx;
  padding: 20rpx 22rpx; font-size: 27rpx; color: var(--ink);
}
.place-link .p-arrow { color: var(--muted); font-size: 20rpx; margin-left: 8rpx; }

.advanced { margin-top: 8rpx; }
.lon-input {
  flex: 1; text-align: right; font-size: 30rpx;
  border-bottom: 1rpx solid var(--line); padding: 4rpx 0;
}
.ph { color: var(--muted); font-size: 26rpx; }

.adv-link { margin: 20rpx 0 4rpx; color: var(--accent); font-size: 24rpx; text-align: center; letter-spacing: 1rpx; }

.btn {
  margin-top: 36rpx;
  background: var(--btn);
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 92rpx;
  height: 92rpx;
  letter-spacing: 6rpx;
  transition: all 0.15s ease;
}
.btn::after { border: none; }
.btn:active, .btn-pressed { transform: scale(0.98); opacity: 0.9; }

/* ---------- 生成过渡 ---------- */
.gen-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 999;
  background: rgba(44, 42, 38, 0.55);
  display: flex; align-items: center; justify-content: center;
}
.gen-box {
  background: var(--card); border-radius: 24rpx; padding: 48rpx 56rpx;
  min-width: 480rpx; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.25);
}
.gen-spinner {
  width: 56rpx; height: 56rpx; border: 4rpx solid var(--line);
  border-top-color: var(--accent); border-radius: 50%;
  animation: spin 0.9s linear infinite; margin: 0 auto 40rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.gen-step { margin-bottom: 22rpx; }
.gen-line { display: flex; align-items: center; color: var(--muted); font-size: 26rpx; animation: fadein 0.3s; }
.gen-line.done { color: var(--muted); text-decoration: line-through; text-decoration-color: var(--line); }
.gen-line.now { color: var(--ink); font-weight: 500; }
.gen-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--accent); margin-right: 16rpx; }
@keyframes fadein { from { opacity: 0; transform: translateY(6rpx); } to { opacity: 1; transform: none; } }

/* ---------- 结果 ---------- */
.result { scroll-margin-top: 24rpx; }
.result-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; }
.result-title { font-size: 34rpx; font-weight: 600; }
.result-tag { color: var(--accent); font-size: 22rpx; border: 1rpx solid var(--line); border-radius: 20rpx; padding: 4rpx 16rpx; }
.result-meta { color: var(--muted); font-size: 26rpx; margin-bottom: 28rpx; }

.pillars { display: flex; justify-content: space-around; padding: 10rpx 0 24rpx; }
.pillar { text-align: center; flex: 1; }
.pillar-label { color: var(--muted); font-size: 22rpx; margin-bottom: 10rpx; letter-spacing: 2rpx; }
.pillar-ganzhi { font-size: 44rpx; font-weight: 600; line-height: 1.25; }
.pillar-elem { margin-top: 10rpx; font-size: 22rpx; color: var(--accent); }

.section-title { font-size: 26rpx; color: var(--muted); margin: 8rpx 0 16rpx; letter-spacing: 2rpx; }

.tally { display: flex; flex-direction: column; }
.tally-row {
  display: flex; align-items: center;
  margin: 10rpx 0;
}
.tally-name { width: 90rpx; font-size: 26rpx; flex-shrink: 0; }
.tally-track {
  flex: 1; height: 18rpx; border-radius: 9rpx;
  background: var(--tint); overflow: hidden;
}
.tally-fill {
  height: 100%; border-radius: 9rpx;
  background: var(--accent); transition: width 0.5s ease;
}
.tally-n { width: 60rpx; text-align: right; font-size: 28rpx; font-weight: 600; color: var(--accent); flex-shrink: 0; }
.tally-empty { color: var(--muted); font-size: 26rpx; }

.kv { display: flex; align-items: baseline; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.kv .approx { font-size: 20rpx; color: var(--muted); margin-left: 8rpx; }
.k { color: var(--muted); font-size: 25rpx; }
.v { font-size: 28rpx; text-align: right; }
.divider { height: 1rpx; background: var(--line); margin: 24rpx 0; }

.note { margin-top: 28rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }

/* ---------- 关于入口 ---------- */
.about-link {
  display: flex; align-items: center; justify-content: center;
  margin: 8rpx 0 24rpx; padding: 28rpx 0;
  color: var(--muted); font-size: 26rpx; letter-spacing: 1rpx;
}
.about-arrow { margin-left: 10rpx; font-size: 30rpx; color: var(--muted); }

