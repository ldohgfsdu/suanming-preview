<view class="page">

  <view class="hero">
    <view class="hero-sub">真实天文历法 · 生辰时间档案</view>
  </view>

  <!-- 今日天时 -->
  <view class="card today-card" wx:if="{{today}}">
    <view class="today-head">
      <view class="today-title">今日天时</view>
      <view class="today-tools">
        <view class="today-info" bindtap="onTodayInfo">ⓘ</view>
        <view class="today-more" bindtap="goToday">详情 ›</view>
      </view>
    </view>
    <view class="today-date" wx:if="{{today.dateText}}">{{today.dateText}}</view>
    <view class="today-ganzhi">{{today.ganzhi}}</view>
    <view class="today-grid">
      <view class="t-cell">
        <view class="t-k">距下节气</view>
        <view class="t-v">{{today.termName}}</view>
        <view class="t-s">{{today.termTime}}</view>
      </view>
      <view class="t-cell">
        <view class="t-k">日出</view>
        <view class="t-v">{{today.sunrise}}</view>
      </view>
      <view class="t-cell">
        <view class="t-k">日落</view>
        <view class="t-v">{{today.sunset}}</view>
      </view>
      <view class="t-cell">
        <view class="t-k">当前时间</view>
        <view class="t-v">{{today.nowText}}</view>
      </view>
    </view>
    <view class="today-moon">月相 {{today.moon}}<text wx:if="{{today.moonAge}}">（朔望月龄 {{today.moonAge}} 天）</text></view>
    <view class="today-foot" bindtap="goTerms">查看全年节气日历 ›</view>
  </view>

  <!-- 输入 -->
  <view class="card form-card">
    <view class="section-head-row">
      <view class="section-head">出生档案</view>
      <view class="reset-today" bindtap="onResetToday">回到今天 ↺</view>
    </view>

    <!-- 公历 / 农历 -->
    <view class="mode-tabs">
      <view class="mode-tab {{calMode === 'solar' ? 'on' : ''}}" bindtap="switchSolarMode">公历</view>
      <view class="mode-tab {{calMode === 'lunar' ? 'on' : ''}}" bindtap="switchLunarMode">农历</view>
    </view>

    <block wx:if="{{calMode === 'solar'}}">
      <view class="row">
        <view class="label">公历日期</view>
        <picker class="picker" mode="date" start="1901-01-01" end="2100-12-31" value="{{solarDate}}" bindchange="onSolarDateChange">
          <view class="picker-value">{{solarDateLabel}}</view>
        </picker>
      </view>
    </block>
    <block wx:else>
      <view class="row">
        <view class="label">农历日期</view>
        <picker class="picker" mode="multiSelector"
          range="{{[lunarYearList, lunarMonthLabels, lunarDayList]}}"
          value="{{lunarValue}}"
          bindcolumnchange="onLunarColumnChange"
          bindchange="onLunarChange">
          <view class="picker-value">{{lunarLabel}}</view>
        </picker>
      </view>
      <view class="lunar-preview" wx:if="{{lunarPreview}}">⇄ 对应公历 {{lunarPreview}}</view>
    </block>

    <!-- 出生时刻：时辰（传统）/ 精确到分（专业）双模式 -->
    <view class="row row-noborder time-row">
      <view class="label">出生时刻</view>

      <!-- 模式切换 -->
      <view class="time-mode">
        <view class="time-mode-item {{timeMode === 'shichen' ? 'is-on' : ''}}" data-mode="shichen" bindtap="onTimeModeTap">时辰</view>
        <view class="time-mode-item {{timeMode === 'precise' ? 'is-on' : ''}}" data-mode="precise" bindtap="onTimeModeTap">精确到分</view>
      </view>
    </view>

    <!-- 时辰模式 -->
    <view class="row" wx:if="{{timeMode === 'shichen'}}">
      <view class="label label-sub">选择时辰</view>
      <picker class="picker" mode="selector" range="{{hourOptions}}" value="{{hourIdx}}" bindchange="onHourChange">
        <view class="picker-value">{{hourLabel}}</view>
      </picker>
    </view>

    <!-- 精确模式：原生时间选择器（时 + 分） -->
    <view class="row" wx:if="{{timeMode === 'precise'}}">
      <view class="label label-sub">选择时刻</view>
      <picker class="picker picker-time" mode="time" value="{{preciseTime}}" bindchange="onPreciseTimeChange">
        <view class="picker-value">{{preciseTime}}</view>
      </picker>
    </view>

    <view class="time-hint" wx:if="{{timeMode === 'precise'}}">
      精确到分钟后，真太阳时校正与时辰判定均按实际时刻计算（历法依据：真太阳时）。
    </view>

    <!-- 性别（存档用，不计入历法数据） -->
    <view class="row row-noborder gender-row">
      <view class="label">性别</view>
      <view class="gender-switch">
        <view wx:for="{{genders}}" wx:key="*this" class="gender-opt {{gender === item ? 'on' : ''}}" data-g="{{item}}" bindtap="onGenderTap">{{item}}</view>
      </view>
    </view>

    <!-- 出生地点 -->
    <view class="sub-head">
      <text>出生地点</text>
      <text class="why" bindtap="onWhyPlace">ⓘ</text>
    </view>
    <view class="place-row">
      <picker class="cell prov" mode="selector" range="{{provNames}}" value="{{provIdx}}" bindchange="onProvChange">
        <view class="cell-head">省</view>
        <view class="cell-body">
          <text class="cell-value">{{provNames[provIdx]}}</text>
          <text class="cell-arrow">▾</text>
        </view>
      </picker>
      <picker class="cell" mode="selector" range="{{cityNames}}" value="{{cityIdx}}" bindchange="onCityChange" wx:if="{{placeMode !== 'municipal'}}">
        <view class="cell-head">市</view>
        <view class="cell-body">
          <text class="cell-value">{{cityNames[cityIdx] || '选市'}}</text>
          <text class="cell-arrow">▾</text>
        </view>
      </picker>
      <picker class="cell" mode="selector" range="{{districtNames}}" value="{{districtIdx}}" bindchange="onDistrictChange">
        <view class="cell-head">区/县</view>
        <view class="cell-body">
          <text class="cell-value">{{districtNames[districtIdx] || '选区'}}</text>
          <text class="cell-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="place-hint">{{placeHint}}</view>

    <!-- 高级：手动经度 -->
    <view class="advanced" wx:if="{{showAdvanced}}">
      <view class="row">
        <view class="label">手动输入经度（东经）</view>
        <input class="lon-input" type="digit" placeholder="如 116.4" value="{{lonText}}" bindinput="onLongitudeInput" bindblur="onApplyLon" placeholder-class="ph" />
      </view>
    </view>
    <view class="adv-link" bindtap="onToggleAdvanced">{{showAdvanced ? '收起高级设置 ▲' : '高级设置：手动输入经度 ▼'}}</view>

    <button class="btn" bindtap="onGenerate" loading="{{generating}}" disabled="{{generating}}">生成档案</button>
    <view class="btn-sub">档案将在独立页面中展示，返回首页可继续调整参数</view>
  </view>

  <!-- 说明 / 历史 入口 -->
  <view class="foot-links">
    <view class="about-link" bindtap="goHistory"><text>历史档案</text><text class="about-arrow">›</text></view>
    <view class="about-link" bindtap="goAbout"><text>关于本工具 · 算法说明 · 免责声明</text><text class="about-arrow">›</text></view>
  </view>

  <view class="foot-note">历法事实，供传统文化研究与娱乐参考</view>

</view>